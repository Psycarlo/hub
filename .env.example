# Written to .env.local by `npx convex dev`; on Vercel, `convex deploy` sets it during the build.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional. Where the deployment serves HTTP routes (uploaded files); derived from VITE_CONVEX_URL when unset.
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional. The name shown in the sidebar, the browser tab and on the sign-in page.
# VITE_APP_NAME=Hub
